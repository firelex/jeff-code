{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"@jeffhub/jeff-code-chord": ["./packages/chord/src/index.ts"],
			"@jeffhub/jeff-code-chord/bundler": ["./packages/chord/src/bundler.ts"],
			"@jeffhub/jeff-code-chord/context": ["./packages/chord/src/context/index.ts"],
			"@jeffhub/jeff-code-chord/delta": ["./packages/chord/src/delta/index.ts"],
			"@jeffhub/jeff-code-chord/node": ["./packages/chord/src/node.ts"],
			"@jeffhub/jeff-code-telemetry": ["./packages/telemetry/src/index.ts"],
			"@jeffhub/jeff-code-telemetry/testing": ["./packages/telemetry/src/testing/index.ts"],
			"@jeffhub/jeff-code-codemode": ["./packages/codemode/src/index.ts"],
			"@jeffhub/jeff-code-codemode/declarations": ["./packages/codemode/src/declarations.ts"],
			"@jeffhub/jeff-code-codemode/source": ["./packages/codemode/src/source.ts"],
			"@jeffhub/jeff-code-codemode/worker": ["./packages/codemode/src/runtime/worker.ts"],
			"@jeffhub/jeff-code-mcp": ["./packages/mcp/src/index.ts"],
			"@jeffhub/jeff-code-mcp/oauth": ["./packages/mcp/src/oauth/index.ts"],
			"@jeffhub/jeff-code-mcp/testing": ["./packages/mcp/src/testing/index.ts"],
			"@jeffhub/jeff-code-ai": ["./packages/ai/src/index.ts"],
			"@jeffhub/jeff-code-ai/oauth": ["./packages/ai/src/oauth.ts"],
			"@jeffhub/jeff-code-ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
			"@jeffhub/jeff-code-ai/dist/*": ["./packages/ai/src/*"],
			"@jeffhub/jeff-code-durable": ["./packages/durable/src/index.ts"],
			"@jeffhub/jeff-code-durable/testing": ["./packages/durable/src/testing/index.ts"],
			"@jeffhub/jeff-code-durable/*": [
				"./packages/durable/src/*.ts",
				"./packages/durable/src/*/index.ts",
				"./packages/durable/src/*"
			],
			"@jeffhub/jeff-code-agent-core": ["./packages/agent/src/index.ts"],
			"@jeffhub/jeff-code": ["./packages/coding-agent/src/index.ts"],
			"@jeffhub/jeff-code/experimental/plugin": [
				"./packages/coding-agent/src/experimental/plugin.ts"
			],
			"@jeffhub/jeff-code/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@jeffhub/jeff-code/*": ["./packages/coding-agent/src/*"],
			"@jeffhub/jeff-code-protocol": ["./packages/protocol/src/index.ts"],
			"@jeffhub/jeff-code-protocol/*": ["./packages/protocol/src/*"],
			"@jeffhub/jeff-code-client": ["./packages/client/src/index.ts"],
			"@jeffhub/jeff-code-client/unix": ["./packages/client/src/unix.ts"],
			"@jeffhub/jeff-code-client/*": ["./packages/client/src/*"],
			"@jeffhub/jeff-code-server": ["./packages/server/src/index.ts"],
			"@jeffhub/jeff-code-server/unix": ["./packages/server/src/transports/unix/index.ts"],
			"@jeffhub/jeff-code-server/*": ["./packages/server/src/*"],
			"typebox": ["./node_modules/typebox"],
			"@jeffhub/jeff-code-tui": ["./packages/tui/src/index.ts"],
			"@jeffhub/jeff-code-tui/*": ["./packages/tui/src/*"],
			"@jeffhub/jeff-code-agent-old": ["./packages/agent-old/src/index.ts"],
			"@jeffhub/jeff-code-agent-old/*": ["./packages/agent-old/src/*"]
		}
	},
	"include": ["scripts/model-catalog-protocol.ts", "scripts/jeff-first-menus.ts", "scripts/model-catalog-protocol.test.ts", "packages/*/src/**/*", "packages/*/test/**/*", "packages/coding-agent/examples/**/*", "packages/agent/examples/**/*"],
	"exclude": ["**/dist/**", "packages/coding-agent/examples/extensions/gondolin/**"]
}
